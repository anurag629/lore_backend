# Django
SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True

# Database (Production)
DATABASE_URL=postgres://user:password@localhost/lore_db

# Web3 / Story Protocol
WEB3_PROVIDER_URI=https://aeneid.storyrpc.io
STORY_PROTOCOL_CHAIN_ID=1315
STORY_PROTOCOL_PRIVATE_KEY=your-wallet-private-key-here
STORY_PROTOCOL_NETWORK=aeneid

# IPFS / Pinata
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# AI / LiteLLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CORS & Security (Production)
ALLOWED_HOSTS=localhost,127.0.0.1,.azurewebsites.net
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-backend.azurewebsites.net
